# Use http://localhost:3000 locally; use https://durgasoftwaresolutions.com in production.
# Exact origin used for canonical metadata AND contact endpoint origin validation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_EMAIL=contact@durgasoftwaresolutions.com
NEXT_PUBLIC_WHATSAPP_NUMBER=

# SERVER ONLY. Never add NEXT_PUBLIC_ to the API key or commit .env.local.
BREVO_API_KEY=
EMAIL_FROM=contact@durgasoftwaresolutions.com
EMAIL_FROM_NAME=DS2 - DurgaSoftwareSolutions
EMAIL_NOTIFICATION_TO=contact@durgasoftwaresolutions.com

# Optional future marketing: leave both blank until hosted forms are configured.
# Signup must require explicit consent and double opt-in; unsubscribe must work.
# Neither contact enquiries nor these links trigger automatic campaign sends.
NEXT_PUBLIC_BREVO_SIGNUP_URL=
NEXT_PUBLIC_BREVO_UNSUBSCRIBE_URL=
